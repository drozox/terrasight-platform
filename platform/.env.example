# =============================================================================
# TerraSight Platform - environment template
# Copia este archivo a .env (no commitear) y ajusta valores.
#
# Estado actual (2026-09-10):
#   - DB prod: Supabase proyecto <PROJECT_REF> (ver notas internas, NO commitear)
#   - Data: REAL del GDB (no demo) — 14 municipios, 656 veredas, 132 predios,
#     1381 propuesta, 5959 vias, etc.
#   - 35 migraciones (01-35, ver scripts/db/init/)
#
# Sprint 23 / P0-2 FINAL-CLOSURE-PLAN: el password del proyecto y la URL
# completa de Supabase fueron removidos del repo. Para desarrollo local,
# pedí los valores al owner del repo y pegálos en `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# DEV (default) — Postgres/PostGIS via Docker local
# -----------------------------------------------------------------------------
# Reemplaza este bloque con el de Supabase (más abajo) cuando deployes.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=terrasight
POSTGRES_PASSWORD=terrasight_dev
POSTGRES_DB=convenio_car_wwf

# Pool
DATABASE_URL=postgresql://terrasight:terrasight_dev@localhost:5433/convenio_car_wwf
PGPOOL_MAX=10

# -----------------------------------------------------------------------------
# PROD — Supabase (Convenio CAR Cundinamarca)
#   - DATABASE_URL (puerto 6543, pooler):  para runtime de la app
#   - DIRECT_URL  (puerto 5432, direct):   para `node scripts/migrate.mjs`
#   - `?sslmode=require` es OBLIGATORIO
#
# Las credenciales reales NO están en el repo. Pegá esto en `.env.local`:
#
#   DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:6543/postgres?sslmode=require
#   DIRECT_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#   PGPOOL_MAX=10
#
# Pedí los valores al owner del repo (NO commitear el .env.local).
# -----------------------------------------------------------------------------
# DATABASE_URL=<PEGAR_EN_.env.local>
# DIRECT_URL=<PEGAR_EN_.env.local>
# PGPOOL_MAX=10

# -----------------------------------------------------------------------------
# Auth (NextAuth v5)
# -----------------------------------------------------------------------------
# Valor aleatorio base64 (32 bytes). NO usar el placeholder en produccion.
# Regenerar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=cambia-esto-por-un-valor-aleatorio-base64

# URL canónica del sitio. Para dev: http://localhost:3000 (o :3001 si :3000
# está ocupado por otro proyecto, p.ej. AeroAdmin AFM).
# Para prod: https://terrasight-convenio.vercel.app (o tu dominio custom).
NEXTAUTH_URL=http://localhost:3000

# Confiar en el host header (true para dev detrás de proxy/OneDrive tunneling).
# Producción: poné false y asegurate que NEXTAUTH_URL sea el canónico.
AUTH_TRUST_HOST=true
