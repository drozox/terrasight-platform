      }
    },
    {
      "table": "sgs_pro_propuesta_poligono",
      "file": "sgs_pro_propuesta_poligono.geojson",
      "loader": "simple",
      "_note": "estado está en sgs_pro_propuesta (super), no en las hijas",
      "fk_lookups": {
        "id_predio": {
          "from_column": "id_predio",
