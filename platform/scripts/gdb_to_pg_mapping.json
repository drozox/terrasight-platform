      }
    },
    {
      "table": "sgs_inf_drenaje_doble",
      "file": "sgs_inf_drenaje_doble.geojson",
      "loader": "simple",
      "_note": "SKIP: GDB tiene MultiPolygon, schema pide MultiLineString. Phase 3.",
      "columns": {
        "nombre_geo": "nombre_geografico",
        "__geometry": "geom"
      }
    },

    {
