        "area_m2":      "area_m2",
        "id_predio":    "id_predio",
        "__geometry": "geom"
      }
    },

    {
      "table": "sgs_inf_via",
      "file": "sgs_inf_via_with_municipio.geojson",
      "loader": "simple",
      "_note": "Phase 2: spatial join con municipio via ogr2ogr ST_Intersects (~30% match). tipo_via/estado_superficie usan DEFAULT del schema (migration 21).",
      "fk_lookups": {
        "id_municipio": {
          "from_column": "id_municipio",
          "to_table": "bcs_lpa_municipio",
          "to_column": "codigo_administrativo"
        }
      },
      "columns": {
        "id_municipio": "id_municipio",
        "__geometry": "geom"
      }
    },
    {
      "table": "sgs_inf_drenaje_simple",
      "file": "sgs_inf_drenaje_simple_with_municipio.geojson",
      "loader": "simple",
      "_note": "Phase 2: spatial join con municipio (100% match).",
      "fk_lookups": {
        "id_municipio": {
          "from_column": "id_municipio",
          "to_table": "bcs_lpa_municipio",
          "to_column": "codigo_administrativo"
        }
      },
      "columns": {
