{
  "_doc": "Mapping GDB -> PG para el import. Editar columnas = { gdb_col: pg_col }. Si una columna GDB no aparece, se ignora. geometry se mapea como la columna GEOMETRY del PG. Derived = no viene de un archivo, se computa en el script. Loaders: 'simple' = lee archivo y mapea, 'junction' = lee archivo y solo inserta FK pairs, 'synthesize' = agrupa valores únicos de otra tabla.",

  "tables": [
    {
      "table": "bcs_lpa_municipio",
      "file": "bcs_lpa_municipio.geojson",
      "loader": "simple",
      "_note": "GDB codigo (DANE) → PG codigo_administrativo. Todos los municipios del convenio están en Cundinamarca (codigo_pro empieza con 25).",
      "columns": {
        "codigo":     "codigo_administrativo",
        "nombre":     "nombre_municipio",
        "_departamento": "departamento",
        "__geometry": "geom"
      },
      "derivations": {
        "departamento": {
          "from": "codigo_pro",
          "map": {
            "250100": "CUNDINAMARCA",
            "250200": "CUNDINAMARCA",
            "250400": "CUNDINAMARCA",
            "250500": "CUNDINAMARCA",
            "250501": "CUNDINAMARCA",
            "250600": "CUNDINAMARCA",
            "250700": "CUNDINAMARCA",
            "250800": "CUNDINAMARCA",
            "251200": "CUNDINAMARCA",
            "251600": "CUNDINAMARCA"
          }
        }
      }
    },
    {
      "table": "bcs_lpa_vereda",
      "file": "bcs_lpa_vereda.geojson",
      "loader": "simple",
      "_note": "GDB cod_vereda → PG codigo_administrativo. id_municipio FK via codigo_mun lookup. area_ha/fuente/vigencia NOT in PG schema — dropped.",
      "fk_lookups": {
        "id_municipio": {
          "from_column": "codigo_mun",
          "to_table": "bcs_lpa_municipio",
          "to_column": "codigo_administrativo"
        }
      },
      "columns": {
        "cod_vereda":   "codigo_administrativo",
        "nombre":       "nombre_vereda",
        "codigo_mun":   "id_municipio",
        "__geometry": "geom"
      }
    },
    {
      "table": "bcs_dh_microcuenca",
      "file": "bcs_dh_microcuenca.geojson",
      "loader": "simple",
      "_note": "PG schema solo tiene codigo/nombre_microcuenca/area — se ignoran cuenca y subcuenca columns del GDB.",
      "columns": {
        "codmc":          "codigo",
        "nombmc":         "nombre_microcuenca",
        "area_ha":        "area",
        "__geometry":     "geom"
      }
    },

    {
      "table": "sgs_com_componente",
      "loader": "derived",
      "derived_from": {
        "source_layers": ["sgs_pro_propuesta_punto", "sgs_pro_propuesta_linea", "sgs_pro_propuesta_poligono"],
        "distinct_column": "componente"
      },
      "columns": { "componente": "nombre" }
    },
    {
      "table": "sgs_com_accion",
      "loader": "derived",
      "derived_from": {
        "source_layers": ["sgs_pro_propuesta_punto", "sgs_pro_propuesta_linea", "sgs_pro_propuesta_poligono"],
        "distinct_columns": ["componente", "accion"]
      },
      "fk_lookups": {
        "componente_nombre": {
          "from_column": "componente",
          "to_table": "sgs_com_componente",
          "to_column": "nombre"
        }
      },
      "columns": {
        "componente_nombre": "id_componente",
        "accion":            "nombre"
      }
    },

    {
      "table": "sgs_amb_cobertura_clc",
      "file": "phase6_4686/sgs_amb_cobertura_clc.geojson",
      "loader": "simple",
      "_note": "Phase 7 (Fase 6): re-import con TODOS los 162 features del GDB (no pre-aggregate). PK = i+1 porque OBJECTID tiene duplicados. Script: scripts/import_phase6_lookups.mjs",
      "columns": {
        "nombre":   "nombre_cobertura",
        "municipio":"municipio_predio",
        "area_ha":  "area_ha",
        "naturalida":"estado_naturalidad",
        "__geometry": "geom"
      }
    },
    {
      "table": "sgs_amb_bioma",
      "file": "sgs_amb_bioma_agg.geojson",
      "loader": "simple",
      "_note": "Phase 2: archivo _agg es dissolve por bioma_iavh (5 unique). PG schema no tiene geom.",
      "columns": {
        "bioma_iavh":  "bioma_iavh",
        "area_ha":     "area_ha",
        "area_m2":     "area_m2"
      }
    },
    {
      "table": "sgs_amb_paramos",
      "file": "sgs_amb_paramos_agg.geojson",
      "loader": "simple",
      "_note": "Phase 2: archivo _agg es dissolve por nombre (10 unique). PG schema no tiene geom ni area_m2.",
      "columns": {
        "nombre":   "nombre_paramo",
        "area_ha":  "area_ha"
      }
    },
    {
      "table": "sgs_amb_zonificacion_pomca",
      "file": "phase6_4686/sgs_amb_zonificacion_pomca.geojson",
      "loader": "simple",
      "_note": "Phase 7 (Fase 6): re-import con TODOS los 245 features del GDB (no pre-aggregate). PK = i+1. Schema extendido con codigo/nomenclatura/descripcion/geom.",
      "columns": {
        "cat_ord":     "categoria_zonificacion",
        "codigo":      "codigo",
        "nomenclat":   "nomenclatura",
        "descrip":     "descripcion",
        "area_ha":     "area_ha",
        "__geometry":  "geom"
      }
    },
    {
      "table": "sgs_amb_zonificacion_rfp",
      "file": "phase6_4686/sgs_amb_zonificacion_rfp.geojson",
      "loader": "simple",
      "_note": "Phase 7 (Fase 6): re-import con TODOS los 486 features del GDB (no pre-aggregate). PK = i+1. Schema extendido con nombre/sub_zonificacion/geom.",
      "columns": {
        "categoria":     "categoria_zonificacion",
        "nombre":        "nombre",
        "sub_zonifi":    "sub_zonificacion",
        "area_ha":       "area_ha",
        "__geometry":    "geom"
      }
    },

    {
      "table": "sgs_pre_propietario",
      "loader": "synthesize",
      "source_layer": "sgs_pre_predio",
      "from_column": "nom_prop",
      "columns": { "nom_prop": "nombre_razon_social" },
      "defaults": { "telefono": "" }
    },
    {
      "table": "sgs_pre_predio",
      "file": "sgs_pre_predio.geojson",
      "loader": "simple",
      "_note": "cedula_ant, longitud_centroide, latitud_centroide dropped (schema no las tiene o son CTM12 que overflows DECIMAL(12,6))",
      "fk_lookups": {
        "id_propietario": {
          "from_column": "nom_prop",
          "to_table": "sgs_pre_propietario",
          "to_column": "nombre_razon_social"
        },
        "id_vereda": {
          "from_column": "cod_vereda",
          "to_table": "bcs_lpa_vereda",
          "to_column": "codigo_administrativo"
        }
      },
      "columns": {
        "id_predio":   "id_predio",
        "nompredio":   "nombre_predio",
        "area_ha":     "area_ha",
        "c_catstral":  "cedula_catastral",
        "cedula_ant":  "cedula_ant",
        "nucpredio":   "nucleo_predial",
        "comentario":  "observaciones",
        "perimetro":   "perimetro",
        "nom_prop":    "id_propietario",
        "cod_vereda":  "id_vereda",
        "__geometry": "geom"
      }
    },

    {
      "table": "sgs_pro_propuesta_punto",
      "file": "sgs_pro_propuesta_punto.geojson",
      "loader": "simple",
      "_note": "estado está en sgs_pro_propuesta (super), no en las hijas",
      "fk_lookups": {
        "id_predio": {
          "from_column": "id_predio",
          "to_table": "sgs_pre_predio",
          "to_column": "id_predio"
        }
      },
      "columns": {
        "id_prop_pu":   "id_prop_punto",
        "actividad":    "actividad",
        "este":         "este",
        "norte":        "norte",
        "descripcion":  "descripcion",
        "id_predio":    "id_predio",
        "__geometry": "geom"
      }
    },
    {
      "table": "sgs_pro_propuesta_linea",
      "file": "sgs_pro_propuesta_linea.geojson",
      "loader": "simple",
      "_note": "estado está en sgs_pro_propuesta (super), no en las hijas",
      "fk_lookups": {
        "id_predio": {
          "from_column": "id_predio",
