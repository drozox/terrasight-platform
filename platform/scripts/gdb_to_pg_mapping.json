    {
      "table": "sgs_pre_propietario",
      "loader": "synthesize",
      "source_layer": "sgs_pre_predio",
      "from_column": "nom_prop",
      "columns": { "nom_prop": "nombre_razon_social" },
      "defaults": { "telefono": "" }
    },
    {
      "table": "sgs_pre_predio",
      "file": "sgs_pre_predio.geojson",
      "loader": "simple",
      "_note": "cedula_ant, longitud_centroide, latitud_centroide dropped (schema no las tiene o son CTM12 que overflows DECIMAL(12,6))",
      "fk_lookups": {
        "id_propietario": {
          "from_column": "nom_prop",
          "to_table": "sgs_pre_propietario",
          "to_column": "nombre_razon_social"
        },
        "id_vereda": {
          "from_column": "cod_vereda",
          "to_table": "bcs_lpa_vereda",
          "to_column": "codigo_administrativo"
        }
      },
      "columns": {
        "id_predio":   "id_predio",
        "nompredio":   "nombre_predio",
        "area_ha":     "area_ha",
        "c_catstral":  "cedula_catastral",
        "cedula_ant":  "cedula_ant",
        "nucpredio":   "nucleo_predial",
        "comentario":  "observaciones",
        "perimetro":   "perimetro",
        "nom_prop":    "id_propietario",
        "cod_vereda":  "id_vereda",
        "__geometry": "geom"
      }
    },

