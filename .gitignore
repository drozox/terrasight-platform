# =============================================================================
# TerraSight — TG-Nikoll root .gitignore
# =============================================================================

# Plataforma Node
platform/node_modules/
platform/.next/
platform/out/
platform/build/

# Secrets (override con .env.example en repo)
platform/.env
platform/.env.local
platform/.env.*.local
# Cobertura preventiva para otras carpetas que se agreguen a futuro:
**/.env
**/.env.local
**/.env.*.local
**/.env.development
**/.env.production

# Logs
*.log
npm-debug.log*
# Logs de Next.js dev (creados al levantar next dev en background)
*.log.err
*.log.out

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Modelo BDG zip (14 MB — se regenera desde el entregable del cliente)
MODELO BDG-*.zip

# Shapefiles del cliente (datos pesados, se regeneran desde el entregable)
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.fbn
*.fbx
*.ain
*.aih
*.atx
*.ixs
*.mxs
*.qix
*.qpj

# Directorio específico de shapefiles del cliente (no versionar)
DOCS/**/Datos_Prueba/

# Material de análisis/inspiración (no versionar — solo referencia local)
geoportal-data-dashboard.zip

# Resúmenes diarios personales (notas de sprint, no del repo)
**/RESUMEN-DIARIO-*.md

# Referencia visual local del geoportal de inspiración (no versionar — solo local)
.ref-geoportal/

# Caché de TypeScript (tsc incremental)
*.tsbuildinfo